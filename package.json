{
  "name": "prowler-api-client",
  "version": "0.1.0",
  "description": "TypeScript client for Prowler API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "openapi-generator-cli generate -i Prowler-API.yaml -g typescript-axios -o src/generated --skip-validate-spec --additional-properties=useSingleRequestParameter=true",
    "build": "tsc",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "test": "node test.js",
    "example:fetch-scans": "ts-node examples/fetch-scans.ts"
  },
  "keywords": [
    "prowler",
    "api",
    "client",
    "typescript",
    "openapi"
  ],
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "@types/node": "^20.0.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "axios": "^1.6.0"
  }
} 